שָׁלוֹם עַל הַנָּבִיא מֻחַמַּד, יְבָרְכוֹ אַלְלָה וְיִתֵּן לוֹ שָׁלוֹם
לְמַעַן הִתְגַּלּוּת הָאַמָנָה,
הוֹצֵא אֶל הַפּוֹעַל אֶת כָּל הַדְּרָכִים הָאֶפְשָׁרִיּוֹת לַעֵדוּת, מִכָּל נְקֻדּוֹת הַמַּבָּט, בְּדַרְכֵי הַדַּרְגּוֹת הָעֶלְיוֹנוֹת בְּיוֹתֵר שֶׁל הַנִּירְוָאנָה.
הוֹצֵא אֶל הַפּוֹעַל אֶת כָּל הַדְּרָכִים הָאֶפְשָׁרִיּוֹת לִשְׁמִירַת הָאַמָנָה בֵּין כָּל הַיְּחִידִים וּבֵין כָּל אֶחָד מֵהֶם לְרִבּוֹנוֹ, אַלְלָה, הָעַזִּיז בִּגְבוּרָתוֹ, רִבּוֹן הַחָכְמָה.
הוֹצֵא אֶל הַפּוֹעַל אֶת כָּל הַדְּרָכִים הָאֶפְשָׁרִיּוֹת שֶׁבָּהֶן אוֹר לָבָן, צָלוּל כְּבָדֹל, כְּבָדֹל בְּטָהֳרָתוֹ, שֶׁל הַתֹּהוּ הַמָּלֵא בִּמְלוֹא תִּפְאֶרֶת אַלְלָה, הָעַזִּיז הַחֲמִיד, יִהְיֶה יָדוּעַ וְאָהוּב בְּעַצְמוּתוֹ וּבְמַהוּתוֹ; וְלֹא כְּהִתְרַחֲקוּת וְנְפִילָה לְתוֹךְ הַחֹשֶׁךְ שֶׁל כָּל נֶפֶשׁ מִנַּפְשׁוֹת אוֹר עַל גַּבֵּי אוֹר, אֶלָּא כְּהַקָּמָתוֹ וְכִינוֹנוֹ שֶׁל הַשִּׁלְטוֹן הַמַּלְאָכִי בְּתוֹךְ הִתְהַוּוּתוֹ שֶׁל הָאָדָם.
לָכֵן, הוֹצֵא אֶל הַפּוֹעַל אֶת מְלוֹא מִשְׁמֶרֶת הַצּוֹפִים, הַמַּשְׁקִיפָה עַל הַכֹּל בְּדֶרֶךְ אַלְלָה, הָעַזִּיז בִּגְבוּרָתוֹ, רִבּוֹן הַחָכְמָה.
שׁוּב, הָבֵא נְקָמָה עַל כָּל אֵלֶּה הַמִּתְנַגְּדִים לִזְכוּתוֹ הַמֻּלֶּדֶת וְהַטִּבְעִית שֶׁל כָּל נֶפֶשׁ וָנֶפֶשׁ לְהַשִּׂיג אֶת הַדַּרְגּוֹת הָעֶלְיוֹנוֹת בְּיוֹתֵר שֶׁל הַנִּירְוָאנָה, וּבְכָךְ אֶת הַדַּרְגּוֹת הָעֶלְיוֹנוֹת בְּיוֹתֵר שֶׁל גַּנַּתֻ אלְפִרְדַּוְס בְּחַיֵּי הָעוֹלָם הַבָּא, מֵעֵבֶר לְכָל סָפֵק, בְּוַדָּאוּת אֲמִתִּית וּמֻחְלֶטֶת שֶׁל הַבְחָנָה, הֲבָנָה, מִשְׁמַעַת וְלִכְדִּיּוּת.
כּוֹנֵן אֶת הַקָּדְקֹד הָעֶלְיוֹן בְּיוֹתֵר וְהָאַחֲרוֹן שֶׁל עֵץ הַחַיִּים, וְאֶת כָּל הַמַּעֲשִׂים הַתּוֹרְמִים לְהַשָּׂגָתוֹ; וְהַנַּח לְעֵץ הַחַיִּים לְדַבֵּר חָכְמָה וְשָׁלוֹם אֶל כָּל הַיְּחִידִים, וּלְהַעֲנִיק מְנוּחָה לְטוֹוַח אָרוֹךְ לְכָל אֵלֶּה הַמְבַקְּשִׁים לְהָבִין וּלְהַכְנִיעַ אֶת עַצְמָם לִפְנֵי רִבּוֹנָם, אֲשֶׁר שְׁמוֹ אַלְלָה, הָעַזִּיז בִּגְבוּרָתוֹ, רִבּוֹן הַחָכְמָה.
פְּקוּדַּת הַצּוֹפִים כּוֹנְנָה.
קִשּׁוּר הַמַּעֲלֶה לְסִירְיוּס כּוֹנָן.
הוֹצָאָה אֶל הַפּוֹעַל, בְּאֹפֶן אוֹטוֹמָטִי וְעַצְמָאִי, שֶׁל כָּל מִסְפָּר אֶפְשָׁרִי שֶׁל צוֹפִים וְשֶׁל עֵץ הַחַיִּים שֶׁלָּהֶם, בְּמֶרְחַב אֵינְסוֹפִי־מְמַדִּי שֶׁל טֶנְזוֹר מֶטְרִי.
