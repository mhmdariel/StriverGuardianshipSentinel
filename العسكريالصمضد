  # ================================================================
  # ١٢. الإِعْلَانُ النِّهَائِيُّ بِقِيَامِ القَوْمِ المُتَجَاهِدِينَ
  # ================================================================
  
  قُلْ "الإِعْلَانُ_النِّهَائِيُّ" = 
    ("بِفَضْلِ اللهِ تَعَالَى وَبِنُورِ القُرْآنِ المُبِينِ، تَمَّ تَكْوِينُ القَوْمِ المُتَجَاهِدِينَ،
     جَيْشُ اللهِ فِي الأَرْضِ، عَلَى مِنْهَاجِ النُّبُوَّةِ،
     يُجَاهِدُونَ فِي سَبِيلِ اللهِ بِالمَالِ وَالنَّفْسِ وَالقَلَمِ وَاللِّسَانِ،
     يُحَارِبُونَ البَاطِلَ بِالحَقِّ، وَيَدْفَعُونَ الظُّلْمَ بِالعَدْلِ،
     يَنْصُرُونَ المُسْتَضْعَفِينَ، وَيَرْفَعُونَ رَايَةَ التَّوْحِيدِ،
     شُجْعَانٌ فِي الحَرْبِ، رُحَمَاءُ بَيْنَهُمْ، أَشِدَّاءُ عَلَى الكُفَّارِ،
     يَسْتَشْهِدُونَ فِي سَبِيلِ اللهِ فَيَحْيَوْنَ عِنْدَ رَبِّهِمْ،
     يَرْجُونَ رَحْمَةَ اللهِ وَفَضْلَهُ،
     وَيَخَافُونَ عَذَابَهُ وَعِقَابَهُ،
     هَذَا هُوَ القَوْمُ المُتَجَاهِدُونَ الَّذِينَ لاَ يُغْلَبُونَ،
     وَمَنْ كَانَ مَعَهُمْ فَهُوَ مَعَ اللهِ،
     وَمَنْ تَخَلَّفَ عَنْهُمْ فَقَدْ تَخَلَّفَ عَنِ النَّصْرِ،
     وَالحَمْدُ للهِ رَبِّ العَالَمِينَ")
  
  إِنَّ (الإِعْلَانُ_النِّهَائِيُّ = حَقٌّ) فَ(
    سُبْحَانَ اللهِ (الإِعْلَانُ_النِّهَائِيُّ)
  )

  # ================================================================
  # ١٣. الدُّعَاءُ الخَاتَمُ لِلْمُتَجَاهِدِينَ
  # ================================================================
  
  وَ(
    سُبْحَانَ اللهِ (اللَّهُمَّ انْصُرِ المُتَجَاهِدِينَ فِي سَبِيلِكَ، وَثَبِّتْ أَقْدَامَهُمْ، وَأَنْزِلْ عَلَيْهِمِ السَّكِينَةَ)
  )
  
  وَ(
    سُبْحَانَ اللهِ (اللَّهُمَّ أَعِزَّهُمْ بِعِزِّكَ، وَقَوِّهِمْ بِقُوَّتِكَ، وَارْزُقْهُمُ الفَتْحَ المُبِينَ)
  )
  
  وَ(
    سُبْحَانَ اللهِ (اللَّهُمَّ اجْعَلْهُمْ رُكْنًا لِلإِسْلَامِ، وَحِصْنًا لِلْمُؤْمِنِينَ، وَنَكَالًا بِالكَافِرِينَ)
  )
  
  وَ(
    سُبْحَانَ اللهِ (اللَّهُمَّ اشْفِ جِرَاحَهُمْ، وَأَجِرْ شُهَدَاءَهُمْ، وَفُكَّ أَسْرَاهُمْ، وَارْزُقْ عَائِلَاتِهِمُ الصَّبْرَ وَالسَّلْوَانَ)
  )
  
  وَ(
    سُبْحَانَ اللهِ (اللَّهُمَّ اجْمَعْ كَلِمَتَهُمْ، وَوَحِّدْ صُفُوفَهُمْ، وَأَلِّفْ بَيْنَ قُلُوبِهِمْ، وَاجْعَلْهُمْ عَلَى الحَقِّ مُسْتَقِيمِينَ)
  )

  # ================================================================
  # ١٤. الخَاتِمَةُ بِآيَاتِ الجِهَادِ وَالقِتَالِ
  # ================================================================
  
  وَ(
    سُبْحَانَ اللهِ (إِنَّ اللَّهَ يُحِبُّ الَّذِينَ يُقَاتِلُونَ فِي سَبِيلِهِ صَفًّا كَأَنَّهُمْ بُنْيَانٌ مَرْصُوصٌ)
  )
  
  وَ(
    سُبْحَانَ اللهِ (إِنَّ جُنْدَ اللهِ هُمُ الْغَالِبُونَ)
  )
  
  وَ(
    سُبْحَانَ اللهِ (وَالَّذِينَ جَاهَدُوا فِينَا لَنَهْدِيَنَّهُمْ سُبُلَنَا ۚ وَإِنَّ اللَّهَ لَمَعَ الْمُحْسِنِينَ)
  )
  
  وَ(
    سُبْحَانَ اللهِ (فَلَا تَهِنُوا وَتَدْعُوا إِلَى السَّلْمِ وَأَنتُمُ الْأَعْلَوْنَ وَاللَّهُ مَعَكُمْ)
  )
  
  وَ(
    سُبْحَانَ اللهِ (سُبْحَانَ اللهِ وَبِحَمْدِهِ، سُبْحَانَ اللهِ العَظِيمِ)
  )
  
  وَ(
    سُبْحَانَ اللهِ (لاَ إِلَهَ إِلَّا اللهُ، مُحَمَّدٌ رَسُولُ اللهِ)
  )
  
  وَ(
    سُبْحَانَ اللهِ (الحَمْدُ للهِ رَبِّ العَالَمِينَ)
  )
  
  وَ(
    أَسْتَغْفِرُ اللهِ (كُلَّ تَقْصِيرٍ فِي تَصْمِيمِ هَذَا البَرْنَامَجِ العَظِيمِ)
  )
  
  وَ(
    سُبْحَانَ اللهِ رَبِّ العَالَمِينَ
  )

