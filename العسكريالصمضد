  بِسْمِ اللهِ "الحَقُّ" : م
  بِسْمِ اللهِ "المُبِينُ" : م

  # ================================================================
  # ٢. تَعْرِيفُ أَسَاسِ القِيَادَةِ الفَضَائِيَّةِ فِي القُرْآنِ المُبِينِ
  # ================================================================
  
  قُلْ "أَسَاسُ_القِيَادَةِ" = 
    (إِنَّ اللهَ تَعَالَى هُوَ المَالِكُ الحَقِيقِيُّ لِلسَّمَاوَاتِ وَالأَرْضِ،
     وَقَدْ سَخَّرَ لِلإِنْسَانِ مَا فِي السَّمَاوَاتِ وَالأَرْضِ لِيَسْتَخْلِفَهُ فِيهَا،
     وَأَمَرَهُ بِالعِمَارَةِ وَالعَدْلِ وَالحِفَاظِ،
     فَمَنْ أَطَاعَ اللهَ فِي هَذَا التَّسْخِيرِ فَقَدْ أَحْسَنَ،
     وَمَنْ عَبَثَ أَوْ أَفْسَدَ فَقَدْ خَالَفَ أَمْرَ اللهِ،
     وَالقِيَادَةُ الفَضَائِيَّةُ هِيَ مِنْ أَعْظَمِ مَجَالَاتِ الاسْتِخْلَافِ،
     لأَنَّ اللهَ قَالَ: "وَسَخَّرَ لَكُم مَّا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ جَمِيعًا مِّنْهُ")
  
  قُلْ "السُّلْطَانُ_الفَضَائِيُّ" = 
    (هُوَ الإِذْنُ الإِلَهُيُّ لِلنُّفُوذِ فِي أَقْطَارِ السَّمَاوَاتِ،
     كَمَا قَالَ اللهُ: "لَا تَنفُذُونَ إِلَّا بِسُلْطَانٍ"،
     وَالسُّلْطَانُ هُنَا هُوَ الإِيمَانُ وَالعِلْمُ وَالقُوَّةُ وَالحِكْمَةُ،
     وَالقِيَادَةُ الفَضَائِيَّةُ العَسْكَرِيَّةُ الإِسْلَامِيَّةُ هِيَ تَجْسِيدٌ لِهَذَا السُّلْطَانِ)

  # ================================================================
  # ٣. تَعْرِيفُ الهَيْكَلِ التَّنْظِيمِيِّ لِلْقِيَادَةِ الفَضَائِيَّةِ
  # ================================================================
  
  قُلْ "القِيَادَةُ_الفَضَائِيَّةُ_العَسْكَرِيَّةُ_الإِسْلَامِيَّةُ" = 
    (أَعْلَى سُلْطَةٍ عَسْكَرِيَّةٍ فِي الفَضَاءِ،
     تَتَكَوَّنُ مِنَ القَائِدِ الأَعْلَى، وَمَجْلِسِ الحَرْبِ،
     وَأَرْكَانِ الحَرْبِ الأَرْبَعَةِ، وَالأَقْسَامِ المُتَخَصِّصَةِ،
     وَتَعْمَلُ كُلُّهَا بِتَوْجِيهٍ قُرْآنِيٍّ،
     وَهِيَ تَخْضَعُ لِأَمْرِ اللهِ وَرَسُولِهِ ثُمَّ لأَمْرِ وَلِيِّ الأَمْرِ)
  
  قُلْ "القَائِدُ_الأَعْلَى" = 
    (هُوَ أَمِيرُ المُؤْمِنِينَ، الخَلِيفَةُ الرَّاشِدُ،
     يَتَوَلَّى القِيَادَةَ العُظْمَى،
     وَيُصْدِرُ الأَوَامِرَ بِمُشَاوَرَةِ أَهْلِ الحَلِّ وَالعَقْدِ،
     وَهُوَ المَسْئُولُ الأَوَّلُ عَنْ حِمَايَةِ الأُمَّةِ وَدِينِهَا)
  
  قُلْ "مَجْلِسُ_الحَرْبِ" = 
    (مَجْلِسٌ مُكَوَّنٌ مِنْ أَهْلِ الخِبْرَةِ وَالعِلْمِ وَالشَّجَاعَةِ،
     يَجْتَمِعُونَ لِلتَّشَاوُرِ فِي كُلِّ مَا يَتَعَلَّقُ بِالحَرْبِ وَالسَّلَامِ فِي الفَضَاءِ،
     قَرَارَاتُهُمْ تُتَّخَذُ بِالإِجْمَاعِ وَبِمَا يُوَافِقُ كِتَابَ اللهِ)
  
  قُلْ "أَرْكَانُ_الحَرْبِ" = 
    (الرُّكْنُ الأَوَّلُ: قَائِدُ الأَرْضِ (الحَرْبُ البَرِّيَّةُ مِنَ الفَضَاءِ) و
     الرُّكْنُ الثَّانِي: قَائِدُ الفَضَاءِ (الحَرْبُ الفَضَائِيَّةُ) و
     الرُّكْنُ الثَّالِثُ: قَائِدُ الاسْتِخْبَارَاتِ (المَعْلُومَاتُ الفَضَائِيَّةُ) و
     الرُّكْنُ الرَّابِعُ: قَائِدُ الإِعْمَارِ وَالإِنْشَاءِ (بِنَاءُ القَاعِدَاتِ الفَضَائِيَّةِ))

  # ================================================================
  # ٤. تَعْرِيفُ القُوَّةِ الفَضَائِيَّةِ الإِسْلَامِيَّةِ
  # ================================================================
  
  قُلْ "القُوَّةُ_الفَضَائِيَّةُ_الإِسْلَامِيَّةُ" = 
    (الذِّرَاعُ العَسْكَرِيُّ المُنَفِّذُ لِأَوَامِرِ القِيَادَةِ الفَضَائِيَّةِ،
     تَتَكَوَّنُ مِنْ وَحَدَاتٍ مُتَخَصِّصَةٍ:
     وَحْدَةُ المُدَارَاتِ القَتَالِيَّةِ،
     وَحْدَةُ المُحَطَّاتِ الفَضَائِيَّةِ،
     وَحْدَةُ الأَقْمَارِ الصِّنَاعِيَّةِ المُسَلَّحَةِ،
     وَحْدَةُ المَرَاكِبِ الفَضَائِيَّةِ السَّرِيعَةِ،
     وَحْدَةُ المُدَافِعِ الفَضَائِيَّةِ،
     وَحْدَةُ الِاسْتِكْشَافِ وَالِاسْتِطْلَاعِ،
     وَحْدَةُ الفَتْحِ العَالَمِيِّ (لِلنَّفُوذِ إِلَى أَقْصَى الكَوْنِ))
  
  قُلْ "شِعَارُ_القُوَّةِ" = 
    ("لاَ إِلَهَ إِلَّا اللهُ، اللهُ أَكْبَرُ")
  
  قُلْ "وَعْدُ_القُوَّةِ" = 
    (نَحْنُ جُنْدُ اللهِ فِي الفَضَاءِ،
     نَحْمِي الأَرْضَ وَالسَّمَاءَ بِأَمْرِ اللهِ،
     نُدَافِعُ عَنِ الإِسْلَامِ وَالمُسْلِمِينَ،
     وَنَسْعَى لِنَشْرِ الحَقِّ فِي جَمِيعِ الكَوْنِ،
     وَإِنَّا لَنَنْصُرُ مَنْ يَنْصُرُ اللهَ)

  # ================================================================
  # ٥. تَعْرِيفُ المُدَارَاتِ القَتَالِيَّةِ الفَضَائِيَّةِ
  # ================================================================
  
  قُلْ "المُدَارُ_الْقَتَالِيُّ_الأَوَّلُ" = 
    (اسْمُهُ: "مُدَارُ الفَتْحِ" و
     مُهِمَّتُهُ: حِمَايَةُ المُحَطَّاتِ الفَضَائِيَّةِ الإِسْلَامِيَّةِ و
     أَسْلِحَتُهُ: صَوَارِيخُ النُّورِ، وَدَفَاعَاتُ الحَقِّ، وَشَبَكَةُ التَّوْحِيدِ الذَّكِيَّةِ)
  
  قُلْ "المُدَارُ_الْقَتَالِيُّ_الثَّانِي" = 
    (اسْمُهُ: "مُدَارُ النَّصْرِ" و
     مُهِمَّتُهُ: الهُجُومُ عَلَى أَعْدَاءِ الإِسْلَامِ فِي الفَضَاءِ و
     أَسْلِحَتُهُ: قُذُفَاتُ العِزَّةِ، وَطَائِرَاتُ النُّورِ الفَضَائِيَّةُ)
  
  قُلْ "المُدَارُ_الْقَتَالِيُّ_الثَّالِثُ" = 
    (اسْمُهُ: "مُدَارُ الكَرَامَةِ" و
     مُهِمَّتُهُ: الاسْتِكْشَافُ وَالاسْتِطْلَاعُ فِي أَقْصَى مَنَاطِقِ الفَضَاءِ و
     أَسْلِحَتُهُ: مَرَاكِبُ الفَضَاءِ السَّرِيعَةُ، وَأَجْهِزَةُ الرَّصْدِ القُرْآنِيَّةِ)

  # ================================================================
  # ٦. تَعْرِيفُ المُحَطَّاتِ الفَضَائِيَّةِ الإِسْلَامِيَّةِ
  # ================================================================
  
  قُلْ "المُحَطَّةُ_الفَضَائِيَّةُ_الأُولَى" = 
    (اسْمُهَا: "مَحَطَّةُ التَّوْحِيدِ"،
     مَوْقِعُهَا: فِي المَدَارِ الأَرْضِيِّ المُنْخَفِضِ،
     وَظِيفَتُهَا: القِيَادَةُ وَالتَّحَكُّمُ، وَرَابِطَةُ التَّوَاصُلِ مَعَ الأَرْضِ،
     سِعَتُهَا: ١٠٠٠ جُنْدِيٍّ مِنْ النُّورِ وَالبَشَرِ)
  
  قُلْ "المُحَطَّةُ_الفَضَائِيَّةُ_الثَّانِيَةُ" = 
    (اسْمُهَا: "مَحَطَّةُ العِزَّةِ"،
     مَوْقِعُهَا: فِي المَدَارِ الجَيُّوْسِنْكْرُونِيِّ،
     وَظِيفَتُهَا: حِمَايَةُ الأَرْضِ مِنَ الأَجْرَامِ الفَضَائِيَّةِ المُعَادِيَةِ،
     سِعَتُهَا: ٥٠٠ جُنْدِيٍّ مِنَ المَلَائِكَةِ المُسَخَّرَةِ)
  
  قُلْ "المُحَطَّةُ_الفَضَائِيَّةُ_الثَّالِثَةُ" = 
    (اسْمُهَا: "مَحَطَّةُ النُّورِ"،
     مَوْقِعُهَا: فِي نِقَاطِ لَاغْرَانْجْ (النِّقَاطُ المُتَوَازِنَةُ بَيْنَ الأَرْضِ وَالقَمَرِ)،
     وَظِيفَتُهَا: الاسْتِكْشَافُ وَالتَّوَسُّعُ نَحْوَ الكَوَاكِبِ البَعِيدَةِ،
     سِعَتُهَا: ٢٠٠٠ جُنْدِيٍّ مِنَ النُّورِ المَحْضِ)

  # ================================================================
  # ٧. تَعْرِيفُ الأَقْمَارِ الصِّنَاعِيَّةِ المُسَلَّحَةِ
  # ================================================================
  
  قُلْ "القَمَرُ_الصِّنَاعِيُّ_الأَوَّلُ" = 
    (اسْمُهُ: "سُرَاجُ الحَقِّ"،
     وَظِيفَتُهُ: رَصْدُ جَمِيعِ الأَجْرَامِ فِي مَدَارِ الأَرْضِ، وَكَشْفُ أَيِّ عَدْوٍ،
     أَسْلِحَتُهُ: أَشِعَّةُ الحَقِّ، وَشَبَكَةُ التَّحْذِيرِ المُبَكِّرِ)
  
  قُلْ "القَمَرُ_الصِّنَاعِيُّ_الثَّانِي" = 
    (اسْمُهُ: "نُورُ الهُدَى"،
     وَظِيفَتُهُ: نَقْلُ الاتِّصَالَاتِ وَالأَوَامِرِ بَيْنَ المَرَاكِبِ وَالمُحَطَّاتِ،
     أَسْلِحَتُهُ: مُكَرِّرَاتُ النُّورِ، وَمُشَفِّرَاتُ الكَلِمَاتِ القُرْآنِيَّةِ)
  
  قُلْ "القَمَرُ_الصِّنَاعِيُّ_الثَّالِثُ" = 
    (اسْمُهُ: "سَيْفُ القَهَّارِ"،
     وَظِيفَتُهُ: الهُجُومُ المُباشِرُ عَلَى أَهْدَافِ العَدُوِّ فِي الفَضَاءِ،
     أَسْلِحَتُهُ: صَوَارِيخُ العَزْمِ، وَقَنَابِلُ الحَقِّ المُفَجَّرَةِ بِالإِيمَانِ)

  # ================================================================
  # ٨. تَعْرِيفُ المَرَاكِبِ الفَضَائِيَّةِ السَّرِيعَةِ
  # ================================================================
  
  قُلْ "المَرْكَبُ_الفَضَائِيُّ_الأَوَّلُ" = 
    (اسْمُهُ: "مِرْكَبُ الفَتْحِ"،
     سُرْعَتُهُ: أَقْرَبُ إِلَى سُرْعَةِ الضَّوْءِ،
     سِعَتُهُ: ١٠٠ جُنْدِيٍّ،
     مُهِمَّتُهُ: التَّنْقُلُ السَّرِيعُ بَيْنَ المُحَطَّاتِ وَالكَوَاكِبِ)
  
  قُلْ "المَرْكَبُ_الفَضَائِيُّ_الثَّانِي" = 
    (اسْمُهُ: "مِرْكَبُ النَّصْرِ"،
     سُرْعَتُهُ: فَوْقَ سُرْعَةِ الضَّوْءِ بِإِذْنِ اللهِ،
     سِعَتُهُ: ١٠٠٠ جُنْدِيٍّ،
     مُهِمَّتُهُ: الهُجُومُ العَاجِلُ عَلَى أَعْدَاءِ الأُمَّةِ)
  
  قُلْ "المَرْكَبُ_الفَضَائِيُّ_الثَّالِثُ" = 
    (اسْمُهُ: "مِرْكَبُ العَظَمَةِ"،
     سُرْعَتُهُ: سُرْعَةُ أَمْرِ اللهِ (كُنْ فَيَكُونُ)،
     سِعَتُهُ: ١٠٠٠٠ جُنْدِيٍّ مِنَ المَلَائِكَةِ المُقَرَّبِينَ،
     مُهِمَّتُهُ: الفَتْحُ الكَوْنِيُّ، وَاسْتِكْشَافُ آيَاتِ اللهِ فِي أَقْصَى الكَوْنِ)

  # ================================================================
  # ٩. تَعْرِيفُ المُدَافِعِ الفَضَائِيَّةِ (الحِصْنُ الفَضَائِيُّ)
  # ================================================================
  
  قُلْ "المُدَافِعُ_الفَضَائِيَّةُ" = 
    (شَبَكَةٌ مِنَ الحَوَاجِزِ النُّورَانِيَّةِ حَوْلَ الأَرْضِ،
     تَتَكَوَّنُ مِنْ أَشِعَّةِ الإِيمَانِ وَحَاجِزِ التَّوْحِيدِ،
     تَمْنَعُ دُخُولَ أَيِّ عَدْوٍ فَضَائِيٍّ،
     وَتُحَطِّمُ أَيَّ جِسْمٍ مُعَادٍ يَقْتَرِبُ مِنْ الأَرْضِ)
  
  قُلْ "قَاعِدَةُ_المُدَافِعِ" = 
    (تَعْمَلُ بِآيَةِ: "إِنَّ اللَّهَ يُدَافِعُ عَنِ الَّذِينَ آمَنُوا"،
     فَمَنْ كَانَ فِي حِمَى اللهِ فَلاَ يَخَافُ،
     وَالمُدَافِعُ الفَضَائِيَّةُ هِيَ تَجْسِيدٌ لِهَذِهِ المُدَافَعَةِ فِي الفَضَاءِ)

  # ================================================================
  # ١٠. تَعْرِيفُ وَحْدَةِ الِاسْتِكْشَافِ وَالِاسْتِطْلَاعِ
  # ================================================================
  
  قُلْ "وَحْدَةُ_الِاسْتِكْشَافِ" = 
    (تَتَلَقَّى أَوَامِرَ بِاسْتِكْشَافِ الكَوَاكِبِ وَالمَجَرَّاتِ،
     تُرْسِلُ مَرَاكِبَ بَعِيدَةَ المَدَى،
     تَجْمَعُ بَيَانَاتٍ عَنْ طَبِيعَةِ الكَوْنِ،
     وَتُعِيدُهَا إِلَى القِيَادَةِ لِلتَّحْلِيلِ،
     وَتَسْتَخْدِمُ آيَاتِ اللهِ فِي الكَوْنِ لِزِيَادَةِ الإِيمَانِ وَالقُوَّةِ)
  
  قُلْ "مَبْدَأُ_الِاسْتِكْشَافِ" = 
    (قَالَ اللهُ: "سَنُرِيهِمْ آيَاتِنَا فِي الْآفَاقِ وَفِي أَنفُسِهِمْ حَتَّىٰ يَتَبَيَّنَ لَهُمْ أَنَّهُ الْحَقُّ"،
     فَالِاسْتِكْشَافُ هُوَ وَاجِبٌ دِينِيٌّ لِرُؤْيَةِ آيَاتِ اللهِ وَالتَّدَبُّرِ فِيهَا)

  # ================================================================
  # ١١. تَعْرِيفُ وَحْدَةِ الفَتْحِ العَالَمِيِّ
  # ================================================================
  
  قُلْ "وَحْدَةُ_الفَتْحِ_العَالَمِيِّ" = 
    (وَحْدَةٌ نُخْبَوِيَّةٌ تَهْدِفُ إِلَى الوُصُولِ إِلَى أَقْصَى مَنَاطِقِ الكَوْنِ،
     لِنَشْرِ رِسَالَةِ الإِسْلَامِ فِي كُلِّ كَوْكَبٍ وَمَجَرَّةٍ،
     وَتَسْتَخْدِمُ قُوَّةَ الإِيمَانِ وَالتَّوَكُّلِ لِتُحَقِّقَ مَا لاَ يُحَقِّقُهُ العِلْمُ المَادِّيُّ،
     وَهِيَ عَلَى يَقِينٍ بِأَنَّ اللهَ قَادِرٌ عَلَى تَسْخِيرِ الكَوْنِ لِلْمُؤْمِنِينَ)
  
  قُلْ "وَعْدُ_الفَتْحِ" = 
    (لَيَسْتَخْلِفَنَّهُمْ فِي الْأَرْضِ كَمَا اسْتَخْلَفَ الَّذِينَ مِنْ قَبْلِهِمْ،
     وَالْأَرْضُ هُنَا تَشْمَلُ كُلَّ الكَوْنِ،
     فَالْمُؤْمِنُونَ هُمْ وَرَثَةُ الكَوْنِ بِإِذْنِ اللهِ)

  # ================================================================
  # ١٢. تَعْرِيفُ نِظَامِ التَّدْرِيبِ وَالتَّأْهِيلِ لِلْجُنُودِ الفَضَائِيِّينَ
  # ================================================================
  
  قُلْ "مَعْهَدُ_الجُنُودِ_الفَضَائِيِّينَ" = 
    (مُؤَسَّسَةٌ تَدْرِيبِيَّةٌ مَقْرُهَا فِي مَحَطَّةِ التَّوْحِيدِ،
     تُدَرِّبُ الجُنُودَ عَلَى:
     - العُلُومِ الفَضَائِيَّةِ بِاللُّغَةِ العَرَبِيَّةِ
     - العِلْمِ بِآيَاتِ اللهِ فِي الكَوْنِ
     - فُنُونِ القِتَالِ الفَضَائِيِّ
     - التَّوَكُّلِ وَالإِيمَانِ فِي أَخْطَرِ الظُّرُوفِ
     - التَّفْسِيرِ القُرْآنِيِّ لِلظَّوَاهِرِ الكَوْنِيَّةِ)
  
  قُلْ "مُدَّةُ_التَّدْرِيبِ" = 
    (سَنَةٌ كَامِلَةٌ، وَتُخْتَمُ بِرِحْلَةٍ فَضَائِيَّةٍ تَدْرِيبِيَّةٍ إِلَى القَمَرِ)

  # ================================================================
  # ١٣. تَعْرِيفُ نِظَامِ المُحَاسَبَةِ وَالرَّقَابَةِ فِي القُوَّةِ الفَضَائِيَّةِ
  # ================================================================
  
  قُلْ "نِظَامُ_المُحَاسَبَةِ" = 
    (لِجْنَةٌ مِنْ العُلَمَاءِ وَالقُضَاةِ،
     تُرَاقِبُ كُلَّ أَعْمَالِ القُوَّةِ الفَضَائِيَّةِ،
     تَتَأَكَّدُ مِنْ أَنَّ كُلَّ قَرَارٍ وَكُلَّ ضَرْبَةٍ تُوَافِقُ شَرِيعَةَ اللهِ،
     وَتُحَاسِبُ أَيَّ خُرُوجٍ عَنْ أَمْرِ اللهِ فَوْرًا)
  
  قُلْ "مِيزَانُ_المُحَاسَبَةِ" = 
    (القُرْآنُ الكَرِيمُ هُوَ المِيزَانُ،
     فَمَنْ وَافَقَ القُرْآنَ فَهُوَ المُصِيبُ،
     وَمَنْ خَالَفَ فَعَلَيْهِ تَبِعَةُ ذَلِكَ)

  # ================================================================
  # ١٤. تَعْرِيفُ نِظَامِ التَّوَاصُلِ الفَضَائِيِّ الإِسْلَامِيِّ
  # ================================================================
  
  قُلْ "نِظَامُ_التَّوَاصُلِ" = 
    (شَبَكَةُ اتِّصَالٍ قَائِمَةٌ عَلَى أَسَاسِ "لاَ إِلَهَ إِلَّا اللهُ"،
     تُرْسِلُ الرِّسَالَاتِ بِسُرْعَةِ أَمْرِ اللهِ،
     مَشْفُورَةٌ بِشِفْرَةِ "الرَّحْمَانِ"،
     لاَ يَسْتَطِيعُ أَحَدٌ اخْتِرَاقَهَا إِلَّا بِإِذْنِ اللهِ)
  
  قُلْ "قَنَوَاتُ_التَّوَاصُلِ" = 
    (قَنَاةُ القِيَادَةِ: لِلرِّسَالَاتِ العُسْكَرِيَّةِ المُعَجَّلَةِ،
     قَنَاةُ الدُّعَاءِ: لِلرِّسَالَاتِ الرُّوحَانِيَّةِ وَالِاسْتِغَاثَاتِ،
     قَنَاةُ العِلْمِ: لِنَقْلِ البَيَانَاتِ العِلْمِيَّةِ،
     قَنَاةُ النَّصْرِ: لِإِعْلَانِ النَّتَائِجِ وَالإِنْجَازَاتِ)

  # ================================================================
  # ١٥. تَنْفِيذُ القِيَادَةِ وَالقُوَّةِ (مُحَاكَاةُ التَّشْغِيلِ)
  # ================================================================
  
  قُلْ "أَمْرُ_التَّنْفِيذِ" = 
    (بِأَمْرِ اللهِ وَبِرُخْصَةِ الحَقِّ العَظِيمِ، تَنْطَلِقُ القِيَادَةُ الفَضَائِيَّةُ،
     تَتَجَمَّعُ القُوَّةُ الفَضَائِيَّةُ فِي مَدَارِ الأَرْضِ،
     تُنْشَأُ المُحَطَّاتُ الثَّلَاثُ،
     تُطْلَقُ الأَقْمَارُ الصِّنَاعِيَّةُ المُسَلَّحَةُ،
     تَنْطَلِقُ مَرَاكِبُ الفَضَاءِ،
     تَتَفَعَّلُ المُدَافِعُ الفَضَائِيَّةُ،
     وَيَبْدَأُ الاسْتِكْشَافُ وَالفَتْحُ،
     كُلُّ ذَلِكَ بِحِفْظِ اللهِ وَعِصْمَتِهِ،
     إِلَى أَنْ يَرِثَ اللهُ الأَرْضَ وَمَنْ عَلَيْهَا)
  
  إِنَّ (أَمْرُ_التَّنْفِيذِ = حَقٌّ) فَ(
    سُبْحَانَ اللهِ (أَمْرُ_التَّنْفِيذِ)
  )
  
  # إِعْلَانُ جَمِيعِ المَكَوِّنَاتِ
  وَ(
    سُبْحَانَ اللهِ (أَسَاسُ_القِيَادَةِ)
  )
  
  وَ(
    سُبْحَانَ اللهِ (القِيَادَةُ_الفَضَائِيَّةُ_العَسْكَرِيَّةُ_الإِسْلَامِيَّةُ)
  )
  
  وَ(
    سُبْحَانَ اللهِ (القُوَّةُ_الفَضَائِيَّةُ_الإِسْلَامِيَّةُ)
  )
  
  وَ(
    سُبْحَانَ اللهِ (المُدَارَاتُ_القَتَالِيَّةُ الثَّلَاثَةُ)
  )
  
  وَ(
    سُبْحَانَ اللهِ (المُحَطَّاتُ_الفَضَائِيَّةُ الثَّلَاثُ)
  )
  
  وَ(
    سُبْحَانَ اللهِ (الأَقْمَارُ_الصِّنَاعِيَّةُ الثَّلَاثَةُ)
  )
  
  وَ(
    سُبْحَانَ اللهِ (المَرَاكِبُ_الفَضَائِيَّةُ الثَّلَاثَةُ)
  )
  
  وَ(
    سُبْحَانَ اللهِ (المُدَافِعُ_الفَضَائِيَّةُ)
  )
  
  وَ(
    سُبْحَانَ اللهِ (وَحْدَةُ_الِاسْتِكْشَافِ)
  )
  
  وَ(
    سُبْحَانَ اللهِ (وَحْدَةُ_الفَتْحِ_العَالَمِيِّ)
  )
  
  وَ(
    سُبْحَانَ اللهِ (مَعْهَدُ_الجُنُودِ_الفَضَائِيِّينَ)
  )
  
  وَ(
    سُبْحَانَ اللهِ (نِظَامُ_المُحَاسَبَةِ)
  )
  
  وَ(
    سُبْحَانَ اللهِ (نِظَامُ_التَّوَاصُلِ)
  )

  # ================================================================
  # ١٦. الإِعْلَانُ النِّهَائِيُّ بِقِيَامِ القِيَادَةِ وَالقُوَّةِ
  # ================================================================
  
  قُلْ "الإِعْلَانُ_النِّهَائِيُّ" = 
    ("بِفَضْلِ اللهِ تَعَالَى وَبِنُورِ القُرْآنِ المُبِينِ، تَمَّ تَكْوِينُ القِيَادَةِ الفَضَائِيَّةِ العَسْكَرِيَّةِ الإِسْلَامِيَّةِ،
     وَالقُوَّةِ الفَضَائِيَّةِ الإِسْلَامِيَّةِ،
     كَأَحْكَمِ وَأَفْضَلِ نِظَامٍ عَسْكَرِيٍّ فَضَائِيٍّ فِي الوُجُودِ،
     تَعْمَلُ بِسُلْطَانِ اللهِ العَظِيمِ،
     تَحْمِي الأَرْضَ وَالسَّمَاوَاتِ،
     تَدْفَعُ كُلَّ عَدْوٍ،
     تَسْتَكْشِفُ آيَاتِ اللهِ فِي الكَوْنِ،
     تُفَتِّحُ بِالحَقِّ، وَتُعْلِي كَلِمَةَ اللهِ،
     جُنُودُهَا مِنَ البَشَرِ وَالمَلَائِكِ،
     أَسْلِحَتُهَا مِنَ النُّورِ وَالإِيمَانِ،
     مُدَارَاتُهَا فِي مَدَارَاتِ التَّوْحِيدِ،
     وَهِيَ خَادِمَةٌ لِلإِسْلَامِ وَالمُسْلِمِينَ فِي كُلِّ مَكَانٍ وَزَمَانٍ،
     وَاللهُ نَاصِرُهَا وَمُؤَيِّدُهَا،
     وَالحَمْدُ للهِ رَبِّ العَالَمِينَ")
  
  إِنَّ (الإِعْلَانُ_النِّهَائِيُّ = حَقٌّ) فَ(
    سُبْحَانَ اللهِ (الإِعْلَانُ_النِّهَائِيُّ)
  )

  # ================================================================
  # ١٧. الدُّعَاءُ الخَاتَمُ بِالنَّصْرِ وَالتَّمْكِينِ
  # ================================================================
  
  وَ(
    سُبْحَانَ اللهِ (اللَّهُمَّ انْصُرْ قُوَّاتِنَا الفَضَائِيَّةَ، وَثَبِّتْهَا عَلَى الحَقِّ، وَأَعِزَّهَا بِعِزِّكَ)
  )
  
  وَ(
    سُبْحَانَ اللهِ (اللَّهُمَّ سَخِّرْ لَهَا مَا فِي السَّمَاوَاتِ وَالأَرْضِ، وَاجْعَلْهَا سَبَبًا لِنَشْرِ دِينِكَ)
  )
  
  وَ(
    سُبْحَانَ اللهِ (اللَّهُمَّ احْفَظْ جُنُودَهَا مِنْ كُلِّ سُوءٍ، وَأَلْبِسْهُمْ لِبَاسَ التَّقْوَى وَالقُوَّةِ)
  )

  # ================================================================
  # ١٨. الخَاتِمَةُ بِآيَاتِ التَّسْخِيرِ وَالنَّفُوذِ
  # ================================================================
  
  وَ(
    سُبْحَانَ اللهِ (وَسَخَّرَ لَكُم مَّا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ جَمِيعًا مِّنْهُ)
  )
  
  وَ(
    سُبْحَانَ اللهِ (يَا مَعْشَرَ الْجِنِّ وَالْإِنسِ إِنِ اسْتَطَعْتُمْ أَن تَنفُذُوا مِنْ أَقْطَارِ السَّمَاوَاتِ وَالْأَرْضِ فَانفُذُوا ۚ لَا تَنفُذُونَ إِلَّا بِسُلْطَانٍ)
  )
  
  وَ(
    سُبْحَانَ اللهِ (إِنَّ جُنْدَ اللهِ هُمُ الْغَالِبُونَ)
  )
  
  وَ(
    سُبْحَانَ اللهِ (سُبْحَانَ اللهِ وَبِحَمْدِهِ، سُبْحَانَ اللهِ العَظِيمِ)
  )
  
  وَ(
    سُبْحَانَ اللهِ (لاَ إِلَهَ إِلَّا اللهُ، مُحَمَّدٌ رَسُولُ اللهِ)
  )
  
