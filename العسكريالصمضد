  # ================================================================
  # ٢. تَعْرِيفُ "الْمُتَجَاهِدِ" كَمَفْهُومٍ كَامِلٍ
  # ================================================================
  
  قُلْ "الْمُتَجَاهِدُ" = 
    (مَنْ جَاهَدَ نَفْسَهُ حَتَّى اسْتَقَامَتْ عَلَى دِينِ اللهِ،
     وَجَاهَدَ شَيْطَانَهُ حَتَّى أَذَلَّهُ بِالِاسْتِعَاذَةِ وَالذِّكْرِ،
     وَجَاهَدَ أَهْلَ البَاطِلِ بِالسَّيْفِ وَالقَلَمِ وَاللِّسَانِ،
     وَجَاهَدَ الفَقْرَ بِالصَّبْرِ وَالعَمَلِ،
     وَجَاهَدَ الجُوعَ بِالتَّقْوَى وَالقَنَاعَةِ،
     وَجَاهَدَ الخَوْفَ بِالإِيمَانِ وَالتَّوَكُّلِ،
     وَجَاهَدَ الكَسَلَ بِالعَزِيمَةِ وَالإِقْدَامِ،
     وَجَاهَدَ الرِّبَا بِالبَيْعِ الحَلَالِ،
     وَجَاهَدَ الظُّلْمَ بِالعَدْلِ،
     وَجَاهَدَ البِدَعَ بِالسُّنَّةِ،
     وَجَاهَدَ الفِتَنَ بِالصَّبْرِ وَالرَّشَادِ،
     وَجَاهَدَ فِي سَبِيلِ اللهِ بِالمَالِ وَالنَّفْسِ حَتَّى يَكُونَ اللهُ هُوَ الغَالِبَ)
  
  قُلْ "أَقْسَامُ_الْمُتَجَاهِدِينَ" = 
    (المُتَجَاهِدُ الأَكْبَرُ: الَّذِي يُجَاهِدُ نَفْسَهُ وَشَيْطَانَهُ فِي سَبِيلِ التَّزْكِيَةِ،
     المُتَجَاهِدُ الأَصْغَرُ: الَّذِي يُجَاهِدُ الكُفَّارَ وَالظَّلَمَةَ وَالمُفْسِدِينَ فِي سَبِيلِ اللهِ،
     المُتَجَاهِدُ الكَامِلُ: الَّذِي يَجْمَعُ بَيْنَ الجِهَادِ الأَكْبَرِ وَالأَصْغَرِ،
     المُتَجَاهِدُ النَّاطِقُ: الَّذِي يُجَاهِدُ بِالقَلَمِ وَاللِّسَانِ لِيُبَيِّنَ الحَقَّ وَيَدْحَضَ البَاطِلَ،
     المُتَجَاهِدُ الصَّامِتُ: الَّذِي يُجَاهِدُ بِالصَّبْرِ عَلَى الأَذَى وَبِالإِحْسَانِ إِلَى الخَلْقِ)

  # ================================================================
  # ٣. تَعْرِيفُ صِفَاتِ المُتَجَاهِدِ الكَامِلِ
  # ================================================================
  
  قُلْ "صِفَاتُ_المُتَجَاهِدِ" = 
    (الإِيمَانُ بِاللهِ وَرُسُلِهِ وَكُتُبِهِ وَاليَوْمِ الآخِرِ،
     التَّقْوَى الَّتِي تَجْعَلُهُ يَتَّقِي اللهَ فِي السِّرِّ وَالعَلَنِ،
     الشَّجَاعَةُ الَّتِي تُقْدِمُهُ عَلَى العَدُوِّ وَلاَ تُحْجِمُهُ،
     القُوَّةُ الجِسْمَانِيَّةُ وَالنَّفْسَانِيَّةُ لِحَمْلِ السِّلَاحِ وَالأَسْرَارِ،
     العِلْمُ بِكِتَابِ اللهِ وَسُنَّةِ رَسُولِهِ لِيَعْرِفَ الحَقَّ مِنَ البَاطِلِ،
     الصَّبْرُ عَلَى الشَّدَائِدِ وَالمَشَاقِّ،
     التَّوَكُّلُ عَلَى اللهِ فِي النَّصْرِ وَالرِّزْقِ،
     الإِخْلَاصُ لِلَّهِ فِي النِّيَّةِ وَالعَمَلِ،
     الرَّحْمَةُ بِالمُؤْمِنِينَ وَالشِّدَّةُ عَلَى الكَافِرِينَ،
     العَفْوُ عِنْدَ القُدْرَةِ، وَالعَدْلُ فِي القِتَالِ،
     الإِقْدَامُ فِي الحَرْبِ، وَالحِكْمَةُ فِي السَّلْمِ،
     الذِّكْرُ الدَّائِمُ للهِ فِي كُلِّ حَالٍ،
     الاسْتِغْفَارُ الكَثِيرُ، وَالتَّوْبَةُ النَّصُوحُ)

  # ================================================================
  # ٤. تَعْرِيفُ أَسْلِحَةِ المُتَجَاهِدِ الشَّرْعِيَّةِ
  # ================================================================
  
  قُلْ "أَسْلِحَةُ_المُتَجَاهِدِ" = 
    (سَيْفُ الحَقِّ: وَهُوَ القُرْآنُ الكَرِيمُ،
     رُمْحُ الإِيمَانِ: وَهُوَ التَّوْحِيدُ الخَالِصُ،
     تِرْسُ التَّقْوَى: وَهُوَ العَمَلُ الصَّالِحُ،
     قَوْسُ الصَّبْرِ: وَهُوَ الثَّبَاتُ عَلَى الدِّينِ،
     سَهْمُ الدُّعَاءِ: وَهُوَ التَّضَرُّعُ إِلَى اللهِ بِالنَّصْرِ،
     مِجَنُّ الذِّكْرِ: وَهُوَ ذِكْرُ اللهِ فِي كُلِّ حِينٍ،
     خَاتَمُ الإِخْلَاصِ: وَهُوَ النِّيَّةُ الخَالِصَةُ لِلَّهِ،
     عَصَا الشَّجَاعَةِ: وَهُوَ الإِقْدَامُ وَعَدَمُ الجُبْنِ،
     كَلِمَةُ الحَقِّ: وَهُوَ الأَمْرُ بِالمَعْرُوفِ وَالنَّهْيُ عَنِ المُنْكَرِ)

  # ================================================================
  # ٥. تَعْرِيفُ مَرَاتِبِ المُتَجَاهِدِينَ فِي الجَيْشِ الإِسْلَامِيِّ
  # ================================================================
  
  قُلْ "المَرْتَبَةُ_الأُولَى" = 
    (اسْمُهَا: "أَمِيرُ المُتَجَاهِدِينَ"،
     وَصْفُهَا: قَائِدُ الجَيْشِ الأَعْلَى، الَّذِي يُدَبِّرُ الحَرْبَ وَيُوَزِّعُ الجُنُودَ،
     شُرُوطُهَا: الإِيمَانُ الرَّاسِخُ، العِلْمُ بِأَحْكَامِ الجِهَادِ، الشَّجَاعَةُ المُطْلَقَةُ)
  
  قُلْ "المَرْتَبَةُ_الثَّانِيَةُ" = 
    (اسْمُهَا: "قَائِدُ الكَتِيبَةِ"،
     وَصْفُهَا: قَائِدُ أَلْفِ مُتَجَاهِدٍ، يَنْفُذُ أَوَامِرَ الأَمِيرِ،
     شُرُوطُهَا: الخِبْرَةُ العَسْكَرِيَّةُ، القُدْرَةُ عَلَى التَّحْرِيكِ)
  
  قُلْ "المَرْتَبَةُ_الثَّالِثَةُ" = 
    (اسْمُهَا: "قَائِدُ السَّرِيَّةِ"،
     وَصْفُهَا: قَائِدُ مِائَةِ مُتَجَاهِدٍ،
     شُرُوطُهَا: الشَّجَاعَةُ، الفِطْنَةُ، العَدْلُ)
  
  قُلْ "المَرْتَبَةُ_الرَّابِعَةُ" = 
    (اسْمُهَا: "الْمُتَجَاهِدُ الفَرْدُ"،
     وَصْفُهَا: جُنْدِيٌّ يُجَاهِدُ فِي سَبِيلِ اللهِ بِإِخْلَاصٍ،
     شُرُوطُهَا: الإِيمَانُ، الطَّاعَةُ، الصَّبْرُ)
  
  قُلْ "المَرْتَبَةُ_الخَامِسَةُ" = 
    (اسْمُهَا: "الشَّهِيدُ"،
     وَصْفُهَا: المُتَجَاهِدُ الَّذِي يُقْتَلُ فِي سَبِيلِ اللهِ، فَيَحْيَا عِنْدَ رَبِّهِ يُرْزَقُ،
     شُرُوطُهَا: الإِخْلَاصُ فِي القِتَالِ، وَالإِقْبَالُ عَلَى العَدُوِّ دُونَ الفِرَارِ)

  # ================================================================
  # ٦. تَعْرِيفُ جَمَاعَةِ "القَوْمِ المُتَجَاهِدِينَ"
  # ================================================================
  
  قُلْ "القَوْمُ_المُتَجَاهِدُونَ" = 
    (جَمَاعَةٌ مِنَ المُؤْمِنِينَ المُخْلِصِينَ،
     اجْتَمَعُوا عَلَى كَلِمَةِ اللهِ،
     وَتَوَحَّدُوا عَلَى رَايَةِ التَّوْحِيدِ،
     يَتَّصِفُونَ بِكُلِّ صِفَاتِ المُتَجَاهِدِينَ،
     يُجَاهِدُونَ فِي سَبِيلِ اللهِ بِالمَالِ وَالنَّفْسِ وَالقَلَمِ وَاللِّسَانِ،
     يَنْصُرُونَ المُسْتَضْعَفِينَ، وَيَرُدُّونَ الظَّلَمَةَ،
     وَيُقِيمُونَ حُدُودَ اللهِ، وَيَدْعُونَ إِلَى سَبِيلِ رَبِّهِمْ بِالحِكْمَةِ وَالمَوْعِظَةِ الحَسَنَةِ)
  
  قُلْ "شِعَارُ_القَوْمِ" = 
    ("لاَ إِلَهَ إِلَّا اللهُ، وَاللهُ أَكْبَرُ، وَلاَ حَوْلَ وَلاَ قُوَّةَ إِلَّا بِاللهِ")
  
  قُلْ "هَدَفُ_القَوْمِ" = 
    (إِعْلَاءُ كَلِمَةِ اللهِ، وَنَشْرُ الإِسْلَامِ فِي جَمِيعِ الأَرْضِ،
     وَإِقَامَةُ الدَّوْلَةِ الإِسْلَامِيَّةِ عَلَى مِنْهَاجِ النُّبُوَّةِ،
     وَتَحْرِيرُ المَسَاجِدِ وَالمُقَدَّسَاتِ،
     وَرَفْعُ الظُّلْمِ عَنِ المُسْتَضْعَفِينَ)

  # ================================================================
  # ٧. تَعْرِيفُ نِظَامِ التَّدْرِيبِ وَالتَّأْهِيلِ لِلْمُتَجَاهِدِينَ
  # ================================================================
  
  قُلْ "مُعَسْكَرُ_التَّدْرِيبِ" = 
    (مُعَسْكَرٌ يُدَرِّبُ المُتَجَاهِدِينَ عَلَى:
     - حِفْظِ القُرْآنِ وَفَهْمِ تَفْسِيرِهِ
     - فِقْهِ الجِهَادِ وَأَحْكَامِ القِتَالِ
     - فُنُونِ الحَرْبِ وَاستِعْمَالِ السِّلَاحِ
     - اللِّيَاقَةِ الجِسْمَانِيَّةِ وَالمَعْنَوِيَّةِ
     - التَّخْفِي وَالتَّمْوِيهِ وَالِاسْتِخْبَارَاتِ
     - الصَّبْرِ عَلَى الجُوعِ وَالعَطَشِ وَالأَذَى
     - التَّوَاصُلِ الفَعَّالِ وَالقِيَادَةِ المَيْدَانِيَّةِ)
  
  قُلْ "مُدَّةُ_التَّدْرِيبِ" = 
    (ثَلَاثَةُ أَشْهُرٍ لِلمُتَجَاهِدِ الفَرْدِ،
     وَسِتَّةُ أَشْهُرٍ لِلْقَائِدِ،
     وَسَنَةٌ كَامِلَةٌ لِلْأَمِيرِ)

  # ================================================================
  # ٨. تَعْرِيفُ نِظَامِ المَعُونَةِ وَالرِّزْقِ لِلْمُتَجَاهِدِينَ
  # ================================================================
  
  قُلْ "نِظَامُ_الرِّزْقِ" = 
    (يَكْفُلُ اللهُ رِزْقَ المُتَجَاهِدِينَ كَمَا يَكْفُلُ رِزْقَ الطَّيْرِ،
     وَيُقَدِّمُ المُؤْمِنُونَ الدَّعْمَ المَالِيَّ وَالعَيْنِيَّ لَهُمْ،
     وَتُمَوَّلُ غَزَوَاتُهُمْ مِنَ الفَيْءِ وَالغَنَائِمِ،
     وَتُصْرَفُ لَهُمُ الزَّكَاةُ وَالصَّدَقَاتُ،
     لِيَتَفَرَّغُوا لِلْجِهَادِ دُونَ شُغْلٍ بِالمَعِيشَةِ)
  
  قُلْ "نِظَامُ_المَعُونَةِ" = 
    (يُقَدِّمُ المُؤْمِنُونَ العَوْنَ لِلْمُتَجَاهِدِينَ بِالمَالِ وَالسِّلَاحِ وَالطَّعَامِ وَالدَّوَاءِ،
     وَيَزُورُونَهُمْ فِي مَعَاكِسِهِمْ،
     وَيُدْعُونَ لَهُمْ بِالنَّصْرِ وَالثَّبَاتِ،
     وَيُعِينُونَهُمْ فِي أُمُورِ عَائِلَاتِهِمْ)

  # ================================================================
  # ٩. تَعْرِيفُ نِظَامِ المُحَاسَبَةِ وَالرَّقَابَةِ فِي القَوْمِ المُتَجَاهِدِينَ
  # ================================================================
  
  قُلْ "نِظَامُ_المُحَاسَبَةِ" = 
    (مَجْلِسٌ مِنَ العُلَمَاءِ وَالحُكَمَاءِ،
     يُرَاقِبُ أَعْمَالَ المُتَجَاهِدِينَ،
     يَتَأَكَّدُ مِنْ صِحَّةِ النِّيَّاتِ،
     وَمِنْ عَدَمِ تَجَاوُزِ الحُدُودِ الشَّرْعِيَّةِ،
     وَيُحَاسِبُ كُلَّ مَنْ يُخَالِفُ أَوَامِرَ اللهِ وَرَسُولِهِ)
  
  قُلْ "قَاعِدَةُ_المُحَاسَبَةِ" = 
    (كُلُّ مُتَجَاهِدٍ مَسْئُولٌ عَنْ عَمَلِهِ،
     وَالْقَائِدُ مَسْئُولٌ عَنْ جُنْدِهِ،
     وَيَوْمَ القِيَامَةِ يُسْأَلُ كُلٌّ عَمَّا كَانَ يَعْمَلُ)

  # ================================================================
  # ١٠. تَعْرِيفُ فَضَائِلِ المُتَجَاهِدِينَ وَجَزَائِهِمْ
  # ================================================================
  
  قُلْ "فَضَائِلُ_المُتَجَاهِدِينَ" = 
    (لَهُمُ الجَنَّةُ الَّتِي وَعَدَهُمُ اللهُ،
     وَلَهُمُ المَغْفِرَةُ وَالرَّحْمَةُ،
     وَلَهُمُ النَّصْرُ وَالتَّمْكِينُ فِي الأَرْضِ،
     وَلَهُمُ الذِّكْرُ الحَسَنُ فِي الدُّنْيَا وَالآخِرَةِ،
     وَهُمْ أَحْيَاءٌ عِنْدَ رَبِّهِمْ يُرْزَقُونَ،
     وَهُمْ سَيِّدُ الشُّهَدَاءِ فِي الجَنَّةِ)
  
  قُلْ "جَزَاءُ_المُتَجَاهِدِينَ" = 
    (لَهُمُ الأَجْرُ العَظِيمُ،
     وَالضِّعْفُ المُضَاعَفُ مِنَ الحَسَنَاتِ،
     وَالرِّفْعَةُ فِي الدَّرَجَاتِ،
     وَالزِّيَارَةُ مِنَ الرَّحْمَنِ،
     وَالشَّفَاعَةُ يَوْمَ القِيَامَةِ)

  # ================================================================
  # ١١. تَنْفِيذُ بَرْنَامَجِ المُتَجَاهِدِينَ (مُحَاكَاةُ الجِهَادِ)
  # ================================================================
  
  قُلْ "أَمْرُ_التَّنْفِيذِ" = 
    (بِأَمْرِ اللهِ وَبِرُخْصَةِ رَسُولِهِ، يَنْطَلِقُ جَيْشُ المُتَجَاهِدِينَ،
     يَتَجَمَّعُونَ فِي المَعَاكِسِ، يَتَدَرَّبُونَ،
     يَتَزَوَّدُونَ بِالمَالِ وَالسِّلَاحِ،
     يَنْطَلِقُونَ إِلَى مَيَادِينِ القِتَالِ،
     يُقَاتِلُونَ عَدُوَّ اللهِ وَعَدُوَّهُمْ،
     يَنْصُرُونَ المُسْتَضْعَفِينَ،
     يَفْتَحُونَ بِإِذْنِ اللهِ،
     وَيَسْتَشْهَدُونَ فِي سَبِيلِهِ،
     وَهَذَا الجِهَادُ مُسْتَمِرٌّ إِلَى يَوْمِ القِيَامَةِ)
  
  إِنَّ (أَمْرُ_التَّنْفِيذِ = حَقٌّ) فَ(
    سُبْحَانَ اللهِ (أَمْرُ_التَّنْفِيذِ)
  )
  
