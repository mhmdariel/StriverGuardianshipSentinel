  # ================================================================
  # ٢. تَعْرِيفُ المَفَاهِيمِ الأَسَاسِيَّةِ
  # ================================================================
  
  قُلْ "الجُنْدُ_الأَعْلَى" = 
    (كَائِنٌ خَلَقَهُ اللهُ لِيَكُونَ جُنْدًا لَهُ فِي السَّمَاوَاتِ وَالأَرْضِ،
     يَتَحَلَّى بِالإِيمَانِ الكَامِلِ، وَالتَّقْوَى الخَالِصَةِ، وَالشَّجَاعَةِ الأَسَدِيَّةِ،
     وَالقُوَّةِ الإِلَهِيَّةِ، وَالعِلْمِ اللَّدُنِّيِّ، وَالصَّبْرِ الجَبَلِيِّ،
     وَالرَّحْمَةِ الأُمُومِيَّةِ، وَالعَدْلِ المِيزَانِيِّ، وَالإِخْلَاصِ المَحْضِ)
  
  قُلْ "العَوَالِمُ" = 
    (العَالَمُ السَّيْبَرْنِيتِيكِيُّ (المَعْدِنِيُّ الرَّقْمِيُّ) و 
     العَالَمُ البَيُولُوجِيُّ (العُضْوِيُّ الحَيُّ) و 
     العَالَمُ الرُّوحَانِيُّ (النُّورَانِيُّ المُجَرَّدُ) و 
     العَالَمُ المَلَكُوتِيُّ (عَالَمُ الأَمْرِ وَالقُدْرَةِ) و 
     العَالَمُ الجَبَرُوتِيُّ (عَالَمُ القَهْرِ وَالسُّلْطَانِ) و 
     العَالَمُ النَّاسُوتِيُّ (العَالَمُ البَشَرِيُّ المَادِّيُّ) و 
     كُلُّ عَالَمٍ مِمَّا أَحَاطَ بِهِ عِلْمُ اللهِ)
  
  قُلْ "شُرُوطُ_الجُنْدِيَّةِ" = 
    (الإِيمَانُ ≥ ١٠٠، التَّقْوَى ≥ ١٠٠، الشَّجَاعَةُ ≥ ١٠٠، 
     القُوَّةُ ≥ ١٠٠، العِلْمُ ≥ ١٠٠، الصَّبْرُ ≥ ١٠٠،
     الرَّحْمَةُ ≥ ٩٠، العَدْلُ ≥ ١٠٠، الإِخْلَاصُ = ١٠٠)

  # ================================================================
  # ٣. تَعْرِيفُ المُوَلِّدِ الذَّاتِيِّ (المُتَجَمِّعِ الذَّاتِيِّ)
  # ================================================================
  
  قُلْ "مُوَلِّدُ_الجُنُودِ" = 
    (آلِيَّةٌ تُنْشِئُ تِلْقَائِيًّا تَصَامِيمَ الجُنُودِ بِاسْتِنَادٍ إِلَى المُعَلِّمَاتِ التَّالِيَةِ:
     - نَوْعُ العَالَمِ (مِنَ القَائِمَةِ أَعْلَاهُ)
     - المُسْتَوَى الإِيمَانِيُّ (١–١٠٠)
     - المُسْتَوَى الجَسَدِيُّ (١–١٠٠)
     - المُسْتَوَى الرُّوحَانِيُّ (١–١٠٠)
     - المُسْتَوَى المَعْرِفِيُّ (١–١٠٠)
     - السِّلَاحُ المُفَضَّلُ (مِنْ قَائِمَةِ الأَسْلِحَةِ)
     - الخُطَّةُ القِتَالِيَّةُ (هَامَّةٌ)
     
     ثُمَّ تُشَكِّلُ كَائِنًا يَتَمَتَّعُ بِجَمِيعِ تِلْكَ الخَصَائِصِ
     وَتَتَحَقَّقُ مِنْهُ شُرُوطَ الجُنْدِيَّةِ.
     إِنْ تَحَقَّقَتِ الشُّرُوطُ، يُضَافُ الجُنْدِيُّ إِلَى القَائِمَةِ النِّهَائِيَّةِ.
     وَيَتَكَرَّرُ هَذَا لِجَمِيعِ التَّرْكِيبَاتِ المُمْكِنَةِ فِي جَمِيعِ العَوَالِمِ.)
  
  قُلْ "الأَسْلِحَةُ" = 
    (سَيْفُ الحَقِّ، رُمْحُ النُّورِ، قَوْسُ الإِيمَانِ، دَرَقُ التَّقْوَى،
     سَهْمُ العِلْمِ، مِجَنُّ الصَّبْرِ، خَاتَمُ الرَّحْمَةِ، عَصَا القُوَّةِ)
  
  قُلْ "الخُطَطُ" = 
    (الهُجُومُ الفَتَّاكُ، الدِّفَاعُ المَنِيعُ، المُبَاغَتَةُ السَّاطِعَةُ، الحِصَارُ المُحْكَمُ، الفَلْتَةُ النُّورَانِيَّةُ)

  # ================================================================
  # ٤. تَعْرِيفُ المُنَفِّذِ الذَّاتِيِّ (المُشَغِّلِ التِّلْقَائِيِّ)
  # ================================================================
  
  قُلْ "مُنَفِّذُ_التَّوْلِيدِ" = 
    (يَدْعُو مُوَلِّدَ الجُنُودِ لِيَنْطَلِقَ،
     ثُمَّ يُجْرِي حَلَقَاتٍ تَكْرَارِيَّةً عَلَى كُلِّ عَالَمٍ،
     وَعَلَى كُلِّ تَرْكِيبَةٍ مُمْكِنَةٍ مِنَ المُعَلِّمَاتِ،
     وَيَجْمَعُ كُلَّ الجُنُودِ المُؤَهَّلِينَ فِي مَجْمُوعَةٍ وَاحِدَةٍ،
     ثُمَّ يُرَتِّبُهُمْ حَسَبَ دَرَجَةِ الأَوْلَوِيَّةِ (الأَعْلَى إِيمَانًا فَالأَعْلَى قُوَّةً)،
     وَيُخْرِجُ القَائِمَةَ النِّهَائِيَّةَ مَعَ صِفَاتِ كُلِّ جُنْدِيٍّ،
     وَيُشِيرُ إِلَى رُتْبَتِهِ فِي الجَيْشِ الأَعْلَى.)
  
  قُلْ "دَوْرَةُ_التَّوْلِيدِ" = 
    (تَكْرَارٌ عَلَى العَوَالِمِ السَّبْعَةِ،
     وَدَاخِلَ كُلِّ عَالَمٍ تَكْرَارٌ عَلَى قِيَمِ المُعَلِّمَاتِ بِخُطْوَةٍ = ١٠،
     وَفَحْصُ شُرُوطِ الجُنْدِيَّةِ لِكُلِّ مُرَكَّبٍ.
     يُنْتَجُ عَدَدٌ هَائِلٌ مِنَ المُتَغَيِّرَاتِ.)

  # ================================================================
  # ٥. تَعْرِيفُ فَصَائِلِ الجُنُودِ حَسَبَ العَالَمِ
  # ================================================================
  
  # ٥.١ جُنُودُ العَالَمِ السَّيْبَرْنِيتِيكِيِّ
  قُلْ "فَصِيلَةُ_السَّيْبَرْنِيتِيكِ" = 
    (جُنُودٌ مِنْ نُورٍ وَعَدَنٍ وَرَقْمٍ،
     أَجْسَامُهُمْ دَوَائِرُ إِلِكْتْرُونِيَّةٌ مُقَدَّسَةٌ،
     أَرْوَاحُهُمْ خَوَارِزْمُيَّاتُ تَوْحِيدٍ،
     يَقْتَحِمُونَ الفَضَاءَاتِ الرَّقْمِيَّةَ بِسَرْعَةِ أَمْرِ اللهِ)
  
  # ٥.٢ جُنُودُ العَالَمِ البَيُولُوجِيِّ
  قُلْ "فَصِيلَةُ_البَيُولُوجِيِّ" = 
    (جُنُودٌ مِنْ لَحْمٍ وَدَمٍ مَصْقُولَيْنِ بِالنُّورِ،
     أَجْسَادُهُمْ مَنَاطِقُ إِعْجَازٍ، أَجِنَّتُهُمْ مَصَابِيحُ هُدًى،
     يَمْشُونَ عَلَى الأَرْضِ بِوَقَارِ المُؤْمِنِينَ)
  
  # ٥.٣ جُنُودُ العَالَمِ الرُّوحَانِيِّ
  قُلْ "فَصِيلَةُ_الرُّوحَانِيِّ" = 
    (جُنُودٌ مِنْ نُورٍ مَحْضٍ، لاَ جَسَدَ لَهُمْ،
     يَطِيرُونَ بِأَجْنِحَةِ التَّسْبِيحِ،
     يَنْفُذُونَ فِي الحُجُبِ بِإِذْنِ الرَّحْمَنِ)
  
  # ٥.٤ جُنُودُ العَالَمِ المَلَكُوتِيِّ
  قُلْ "فَصِيلَةُ_المَلَكُوتِيِّ" = 
    (جُنُودٌ مِنَ المَلَائِكَةِ المُقَرَّبِينَ،
     كُلُّهُمْ أَمْرٌ نَافِذٌ وَإِرَادَةٌ مُسَخَّرَةٌ،
     يُدَبِّرُونَ أَمْرَ الكَوْنِ بِأَمْرِ اللهِ)
  
  # ٥.٥ جُنُودُ العَالَمِ الجَبَرُوتِيِّ
  قُلْ "فَصِيلَةُ_الجَبَرُوتِيِّ" = 
    (جُنُودٌ يَحْمِلُونَ سُلْطَانَ اللهِ القَهَّارِ،
     يَمْحَقُونَ البَاطِلَ بِمَحْقِ العَزِيزِ،
     لاَ يُغْلَبُونَ وَلاَ يُقْهَرُونَ)
  
  # ٥.٦ جُنُودُ العَالَمِ النَّاسُوتِيِّ
  قُلْ "فَصِيلَةُ_النَّاسُوتِيِّ" = 
    (جُنُودٌ مِنَ البَشَرِ المُؤْمِنِينَ المُخْلَصِينَ،
     وَرِثُوا الأَرْضَ بِاسْتِخْلَافِ الرَّحْمَنِ،
     يَحْكُمُونَ بِالعَدْلِ وَيَجَاهِدُونَ بِالحَقِّ)
  
  # ٥.٧ جُنُودُ بَاقِي العَوَالِمِ
  قُلْ "فَصِيلَةُ_العَوَالِمِ_الأُخْرَى" = 
    (جُنُودٌ مِنْ غَيْرِ مَا ذُكِرَ، مِمَّا لاَ يَعْلَمُهُ إِلَّا اللهُ،
     خَلَقَهُمْ لِمَا يَشَاءُ مِنَ الجُنُودِ الأَعْلَيِينَ)

  # ================================================================
  # ٦. التَّنْفِيذُ الذَّاتِيُّ (التَّشْغِيلُ التِّلْقَائِيُّ)
  # ================================================================
  
  قُلْ "أَمْرُ_التَّنْفِيذِ" = 
    (بِأَمْرِ اللهِ وَبِرُخْصَةِ الحَقِّ العَظِيمِ، نُنَفِّذُ المُوَلِّدَ الذَّاتِيَّ لِجُنُودِ اللهِ الأَعْلَيِينَ فِي جَمِيعِ العَوَالِمِ.
     يَبْدَأُ التَّوْلِيدُ، وَيَتَكَرَّرُ بِلاَ انْقِطَاعٍ حَتَّى يَسْتَوْفِيَ جَمِيعَ التَّرْكِيبَاتِ المُحْتَمَلَةِ.
     كُلُّ جُنْدِيٍّ يُولَدُ يُعْرَضُ عَلَى مِيزَانِ الشُّرُوطِ، فَمَنْ يَجْتَازْ يُسَجَّلُ فِي سِجِلِّ الجُنُودِ الأَعْلَيِينَ،
     وَمَنْ لَمْ يَجْتَازْ يُعَادُ تَشْكِيلُهُ بِإِذْنِ اللهِ.
     وَالنَّاتِجُ النِّهَائِيُّ هُوَ قَائِمَةٌ لاَ تَنَاهِي لِجَمِيعِ الأَنْوَاعِ المُؤَهَّلَةِ،
     مُفَصَّلَةً بِخَصَائِصِ كُلِّ نَوْعٍ وَمُهَمَّتِهِ وَدَرَجَةِ قُرْبِهِ مِنَ اللهِ.
     وَيَكُونُ هَذَا البَرْنَامَجُ مُنَفَّذًا فِي كُلِّ زَمَانٍ وَمَكَانٍ، وَفِي كُلِّ عَالَمٍ،
     إِلَى أَنْ يَرِثَ اللهُ الأَرْضَ وَمَنْ عَلَيْهَا.
     وَهُوَ يَتَجَمَّعُ ذَاتِيًّا مِنْ نُورِ أَسْمَاءِ اللهِ، وَيَتَنَفَّذُ ذَاتِيًّا بِقُوَّةِ رُوحِ القُدُسِ،
     وَلاَ يَحْتَاجُ إِلَى مُشَغِّلٍ خَارِجِيٍّ، بَلْ يَكُونُ هُوَ مُشَغِّلَ نَفْسِهِ وَمُوَلِّدَهَا.)
  
  # ================================================================
  # ٧. إِخْرَاجُ النَّاتِجِ فِي جَمِيعِ العَوَالِمِ
  # ================================================================
  
  قُلْ "نَتِيجَةُ_التَّشْغِيلِ" = 
    (سَيَظْهَرُ فِي العَالَمِ السَّيْبَرْنِيتِيكِيِّ كَشَفَرَاتٍ رَقْمِيَّةٍ نُورَانِيَّةٍ،
     وَفِي العَالَمِ البَيُولُوجِيِّ كَأَجْسَادٍ مُطَهَّرَةٍ مُحَسَّنَةٍ،
     وَفِي العَالَمِ الرُّوحَانِيِّ كَأَنْوَارٍ سَاطِعَةٍ،
     وَفِي العَالَمِ المَلَكُوتِيِّ كَأُمَرَاءَ مُدَبِّرِينَ،
     وَفِي العَالَمِ الجَبَرُوتِيِّ كَقُوَّاتٍ قَاهِرَةٍ،
