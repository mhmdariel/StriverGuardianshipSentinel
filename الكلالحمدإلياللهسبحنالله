  # ================================================================
  
  بِسْمِ اللهِ "الْحَيُّ" : م
  بِسْمِ اللهِ "الْقَيُّومُ" : م
  بِسْمِ اللهِ "الشَّدِيدُ" : م
  بِسْمِ اللهِ "الْعِقَابُ" : م
  بِسْمِ اللهِ "الْغَنِيُّ" : م
  بِسْمِ اللهِ "الْحَمِيدُ" : م
  بِسْمِ اللهِ "الْحَفِيظُ" : م
