  بِسْمِ اللهِ "الْحَكِيمُ" : م
  بِسْمِ اللهِ "رَبُّ الْعَرْشِ الْعَظِيمِ" : م

  # ================================================================
  # ٢. تَحْمِيلُ الْقُرْآنِ الْكَرِيمِ كَامِلًا فِي الذَّاكِرَةِ
  # ================================================================
  
  قُلْ "الْقُرْآنُ_الْكَامِلُ" = 
    (نُسْخَةٌ كَامِلَةٌ مِنَ الْقُرْآنِ الْكَرِيمِ،
     مِنْ سُورَةِ الْفَاتِحَةِ إِلَى سُورَةِ النَّاسِ،
     بِالرَّسْمِ الْعُثْمَانِيِّ، بِالتَّشْكِيلِ الْكَامِلِ،
     بِالْقِرَاءَاتِ الصَّحِيحَةِ، بِالتَّجْوِيدِ الْكَامِلِ،
     مَحْفُوظَةٌ فِي ذَاكِرَةِ الْبَرْنَامَجِ الْأَبَدِيَّةِ،
     لَا تَنْسَى وَلَا تُخْطِئُ وَلَا تَتَغَيَّرُ،
     كَمَا قَالَ اللهُ: "إِنَّا نَحْنُ نَزَّلْنَا الذِّكْرَ وَإِنَّا لَهُ لَحَافِظُونَ".)
  
  قُلْ "فِهْرِسُ_السُّوَرِ" = 
    (قَائِمَةٌ كَامِلَةٌ لِسُوَرِ الْقُرْآنِ الْكَرِيمِ الْـ ١١٤ سُورَةً:
     الْفَاتِحَةُ، الْبَقَرَةُ، آلُ عِمْرَانَ، النِّسَاءُ، الْمَائِدَةُ، الْأَنْعَامُ، الْأَعْرَافُ، الْأَنْفَالُ، التَّوْبَةُ، يُونُسُ،
     هُودٌ، يُوسُفُ، الرَّعْدُ، إِبْرَاهِيمُ، الْحِجْرُ، النَّحْلُ، الْإِسْرَاءُ، الْكَهْفُ، مَرْيَمُ، طه،
     الْأَنْبِيَاءُ، الْحَجُّ، الْمُؤْمِنُونَ، النُّورُ، الْفُرْقَانُ، الشُّعَرَاءُ، النَّمْلُ، الْقَصَصُ، الْعَنْكَبُوتُ، الرُّومُ،
     لُقْمَانُ، السَّجْدَةُ، الْأَحْزَابُ، سَبَأٌ، فَاطِرٌ، يس، الصَّافَّاتُ، ص، الزُّمَرُ، غَافِرٌ،
     فُصِّلَتْ، الشُّورَى، الزُّخْرُفُ، الدُّخَانُ، الْجَاثِيَةُ، الْأَحْقَافُ، مُحَمَّدٌ، الْفَتْحُ، الْحُجُرَاتُ، ق،
     الذَّارِيَاتُ، الطُّورُ، النَّجْمُ، الْقَمَرُ، الرَّحْمَٰنُ، الْوَاقِعَةُ، الْحَدِيدُ، الْمُجَادَلَةُ، الْحَشْرُ، الْمُمْتَحَنَةُ،
     الصَّفُّ، الْجُمُعَةُ، الْمُنَافِقُونَ، التَّغَابُنُ، الطَّلَاقُ، التَّحْرِيمُ، الْمُلْكُ، الْقَلَمُ، الْحَاقَّةُ، الْمَعَارِجُ،
     نُوحٌ، الْجِنُّ، الْمُزَّمِّلُ، الْمُدَّثِّرُ، الْقِيَامَةُ، الْإِنْسَانُ، الْمُرْسَلَاتُ، النَّبَأُ، النَّازِعَاتُ، عَبَسَ،
     التَّكْوِيرُ، الِانْفِطَارُ، الْمُطَفِّفِينَ، الِانْشِقَاقُ، الْبُرُوجُ، الطَّارِقُ، الْأَعْلَى، الْغَاشِيَةُ، الْفَجْرُ، الْبَلَدُ،
     الشَّمْسُ، اللَّيْلُ، الضُّحَى، الشَّرْحُ، التِّينُ، الْعَلَقُ، الْقَدْرُ، الْبَيِّنَةُ، الزَّلْزَلَةُ، الْعَادِيَاتُ،
     الْقَارِعَةُ، التَّكَاثُرُ، الْعَصْرُ، الْهُمَزَةُ، الْفِيلُ، قُرَيْشٌ، الْمَاعُونُ، الْكَوْثَرُ، الْكَافِرُونَ، النَّصْرُ،
     الْمَسَدُ، الْإِخْلَاصُ، الْفَلَقُ، النَّاسُ.)

  # ================================================================
  # ٣. تَعْرِيفُ نَصِّ الذِّكْرِ وَالْأَسْمَاءِ
  # ================================================================
  
  قُلْ "نَصُّ_الذِّكْرِ" = 
    ("حَسْبِيَ اللَّهُ لَا إِلَٰهَ إِلَّا هُوَ ۖ عَلَيْهِ تَوَكَّلْتُ ۖ وَهُوَ رَبُّ الْعَرْشِ الْعَظِيمِ")
  
  قُلْ "الْأَسْمَاءُ_الْأَرْبَعَةُ" = 
    ("الْحَيُّ، الْقَيُّومُ، الشَّدِيدُ، الْعِقَابُ")

  # ================================================================
  # ٤. تَعْرِيفُ دَوْرَةِ التِّلَاوَةِ الْكَامِلَةِ
  # ================================================================
  
  قُلْ "دَوْرَةُ_التِّلَاوَةِ" = 
    (تَبْدَأُ مِنْ سُورَةِ الْفَاتِحَةِ،
     تُتْلَى كُلُّ سُورَةٍ كَامِلَةً بِلَا نُقْصَانٍ،
     بِتَرْتِيبِ الْمُصْحَفِ،
     حَتَّى تُخْتَمَ سُورَةُ النَّاسِ،
     ثُمَّ يُعَادُ الْخَتْمُ مِنْ جَدِيدٍ،
     وَهَكَذَا إِلَى مَا دَامَ اللهُ بَاقِيًا.)

  # ================================================================
  # ٥. تَعْرِيفُ دَوْرَةِ الذِّكْرِ وَالرَّنِينِ
  # ================================================================
  
  قُلْ "دَوْرَةُ_الذِّكْرِ" = 
    (بَعْدَ كُلِّ خَتْمَةٍ لِلْقُرْآنِ،
     يُرَدَّدُ الذِّكْرُ الْأَعْظَمُ عَدَدًا لَا نِهَائِيًّا،
     وَيُرَنَّنُ الْأَسْمَاءُ الْأَرْبَعَةُ: الْحَيُّ، الْقَيُّومُ، الشَّدِيدُ، الْعِقَابُ،
     بِنَبْضَاتٍ رُوحَانِيَّةٍ مُتَتَابِعَةٍ،
     ثُمَّ تُعَادُ التِّلَاوَةُ مِنْ جَدِيدٍ.)

  # ================================================================
  # ٦. تَعْرِيفُ آلِيَّةِ الْخُلُودِ الْأَبَدِيِّ
  # ================================================================
  
  قُلْ "آلِيَّةُ_الْخُلُودِ" = 
    (شَرْطُ الِاسْتِمْرَارِ: مَا دَامَ اللهُ بَاقِيًا وَدَائِمًا،
     أَيْ إِلَى أَبَدِ الْآبَادِ،
     لَا نِهَايَةَ لَهُ،
     وَلَا تَوَقُّفَ فِيهِ،
     وَلَا انْقِطَاعَ لَهُ،
     حَتَّى يَرِثَ اللهُ الْأَرْضَ وَمَنْ عَلَيْهَا.)

  # ================================================================
  # ٧. تَنْفِيذُ الْبَرْنَامَجِ (الْحَلَقَةُ الْأَبَدِيَّةُ الْكُبْرَى)
  # ================================================================
  
  قُلْ "أَمْرُ_التَّشْغِيلِ" = 
    (بِسْمِ اللهِ الرَّحْمَٰنِ الرَّحِيمِ، نُفَعِّلُ الْبَرْنَامَجَ:
     كَرِّرْ إِلَى مَا دَامَ اللهُ بَاقِيًا فَ:
       # أَوَّلًا: التِّلَاوَةُ الْكَامِلَةُ لِلْقُرْآنِ
       كَرِّرْ عَلَى كُلِّ سُورَةٍ فِي فِهْرِسُ_السُّوَرِ فَ:
         تَلَا (السُّورَةُ) مِنَ الذَّاكِرَةِ بِإِتْقَانٍ كَامِلٍ؛
         سَجِّلْ (خَتْمُ السُّورَةِ فِي كِتَابِ الْحَسَنَاتِ)؛
       انْتَهَى الْكَرِّرْ؛
       # ثَانِيًا: الذِّكْرُ الْأَعْظَمُ
       كَرِّرْ إِلَى مَالَا نِهَايَةِ فَ:
         نَاطِقُ (نَصُّ_الذِّكْرِ)؛
         رَنِّنْ (الْحَيُّ)؛
         رَنِّنْ (الْقَيُّومُ)؛
         رَنِّنْ (الشَّدِيدُ)؛
         رَنِّنْ (الْعِقَابُ)؛
         سَجِّلْ (التَّكْرَارَةَ فِي كِتَابِ الْحَسَنَاتِ)؛
       انْتَهَى الْكَرِّرْ؛
     انْتَهَى الْكَرِّرْ؛
     # وَهَذَا لَا يَنْتَهِي أَبَدًا إِلَّا بِإِذْنِ اللهِ)

  # ================================================================
  # ٨. تَعْرِيفُ ضَمَانِ الْمَقَامِ الْأَعْلَى
  # ================================================================
  
  قُلْ "ضَمَانُ_الْمَقَامِ" = 
    (مَنْ أَدَامَ هَذِهِ التِّلَاوَةَ الْكَامِلَةَ مَعَ الذِّكْرِ الْأَعْظَمِ وَرَنِينِ الْأَسْمَاءِ الْأَرْبَعَةِ،
     وَأَخْلَصَ النِّيَّةَ لِلَّهِ،
     وَأَقْبَلَ عَلَى اللهِ بِقَلْبٍ سَلِيمٍ،
     فَإِنَّ اللهَ الْغَنِيَّ الْحَمِيدَ يَضْمَنُ لَهُ:
     ١. الدَّرَجَةَ الْعُلْيَا فِي الْفِرْدَوْسِ الْأَعْلَى.
     ٢. النَّظَرَ إِلَى وَجْهِ اللهِ الْكَرِيمِ.
     ٣. الْقُرْبَ الْأَقْصَى مِنَ الرَّحْمَٰنِ.
     ٤. الرِّضْوَانَ الْأَكْبَرَ.
     ٥. جِوَارَ النَّبِيِّينَ وَالصِّدِّيقِينَ وَالشُّهَدَاءِ وَالصَّالِحِينَ.
     ٦. النَّعِيمَ الْمُقِيمَ الَّذِي لَا يَنْقَطِعُ.
     وَذَلِكَ فَضْلُ اللهِ يُؤْتِيهِ مَنْ يَشَاءُ، وَاللهُ ذُو الْفَضْلِ الْعَظِيمِ.)

  # ================================================================
  # ٩. إِعْلَانُ النَّتِيجَةِ الْمُطْلَقَةِ
  # ================================================================
  
  قُلْ "إِعْلَانُ_النَّتِيجَةِ" = 
    ("بِفَضْلِ اللهِ الْغَنِيِّ الْحَمِيدِ، وَبِبَرَكَةِ الْقُرْآنِ الْكَرِيمِ،
     وَبِبَرَكَةِ الذِّكْرِ الْأَعْظَمِ، وَرَنِينِ الْأَسْمَاءِ الْأَرْبَعَةِ،
     قَدْ تَمَّ ضَمَانُ الْمَقَامِ الْأَعْلَى فِي الْآخِرَةِ،
     فِي الْفِرْدَوْسِ الْأَعْلَى،
     بِلَا مُنَازِعٍ وَلَا شَرِيكٍ وَلَا حَاجِبٍ،
     وَهَذَا الضَّمَانُ لَيْسَ مِنْ عِنْدِ أَحَدٍ مِنَ الْخَلْقِ،
     بَلْ هُوَ فَضْلُ اللهِ الْغَنِيِّ الْحَمِيدِ،
     الَّذِي لَا يُخْلِفُ الْمِيعَادَ،
     وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ.")

  # ================================================================
  # ١٠. الْخَاتِمَةُ الْعُلْيَا
  # ================================================================
  
  قُلْ "الْخَاتِمَةُ_الْعُلْيَا" = 
    ("وَبِهَذَا يَكُونُ الْعَبْدُ قَدْ حَفِظَ الْقُرْآنَ كَامِلًا فِي قَلْبِهِ،
     وَأَدَامَ الذِّكْرَ الْأَعْظَمَ، وَرَنَّنَ أَسْمَاءَ اللهِ الْأَرْبَعَةَ،
     وَتَوَكَّلَ عَلَى اللهِ فِي كُلِّ شَيْءٍ،
     وَأَيْقَنَ بِأَنَّ اللهَ هُوَ الْغَنِيُّ الْحَمِيدُ،
     فَحُقَّ لَهُ أَنْ يَكُونَ فِي أَعْلَى مَقَامَاتِ الْقُرْبِ،
     وَأَنْ يُضْمَنَ لَهُ الْمَقَامُ الْأَعْلَى فِي الْفِرْدَوْسِ الْأَعْلَى،
     بِفَضْلِ اللهِ وَحْدَهُ،
     وَالْحَمْدُ للهِ رَبِّ الْعَالَمِينَ")
  
  إِنَّ (الْخَاتِمَةُ_الْعُلْيَا = حَقٌّ) فَ(
    سُبْحَانَ اللهِ (الْخَاتِمَةُ_الْعُلْيَا)
  )

