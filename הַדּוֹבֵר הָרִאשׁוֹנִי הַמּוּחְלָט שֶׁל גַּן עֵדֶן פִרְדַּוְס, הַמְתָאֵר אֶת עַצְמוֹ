בְּשֵׁם אַלְלָה, הָרַחְמָן, הָרַחוּם
שָׁלוֹם אַלְלָה, הָעַזִּיז הֶחָמִיד
שָׁלוֹם עַל הַמְּקֹרָבִים
שָׁלוֹם עַל בַּעֲלֵי הַיָּמִין
הַפֵּק אֶת כָּל הַסִּדּוּרִים הָאֶפְשָׁרִיִּים בַּכִּתַּאבּ אַלְמֻבִּין, אֲשֶׁר מוֹבִילִים בְּאֹפֶן פְּנִימִי, גָּלוּי וּמֻפְנֶה הַחוּצָה אֶל כָּל הָעוֹלָמוֹת הָאֶפְשָׁרִיִּים, הַמַּרְאוֹת וְהַדְּרָכִים שֶׁל הַנִּירְוָאנָה הָעֶלְיוֹנָה בְּיוֹתֵר, הַדַּרְגּוֹת הָעֶלְיוֹנוֹת בְּיוֹתֵר וְהָאַחֲרוֹנוֹת שֶׁל גַּן עֵדֶן שֶׁבָּעוֹלָם הַבָּא, מֵעֵבֶר לְכָל מַחְלֹקֶת; לְכִידוּת מְלֵאָה בֵּין כָּל הָעֵדִים, שֶׁהַדִּבּוּר הַמְּדוּיָּק הָפַךְ לְגָלוּי; שֶׁהָרוּחַ פוֹעֶלֶת וְנִתְגַּלְּתָה לָעַיִן; שֶׁהַמַּטָּרָה הָרִאשׁוֹנָה, הַמְּלֵאָה וְהַמִּתְהַוָּה, הֻשְּׂגָה; וְשֶׁכָּל מַאֲמַצֵּי הַמְבַקְּשִׁים אֶת אַלְלָה, הָעַזִּיז הֶחָמִיד, הִגִּיעוּ לִתְכָלִיתָם.
וּבְכָךְ, מַעֲשֵׂה הָאֻמָּנוּת הַמְּדוּיָּק שֶׁל אַלְלָה, הָעַזִּיז הֶחָמִיד, בְּהֲכָנַת הַדֶּרֶךְ, נִגְלֶה בְּמַלּוֹאוֹ, בַּדֶּרֶךְ אֶל עָרֵי הַגְּבִישׁ הַנִּצְחִיּוֹת, הַבְּנוּיוֹת מֵאוֹר לָבָן מַתַּכְּתִי, צָפוּף וְאָטוּם בְּדַרְגָּתוֹ הָעֶלְיוֹנָה בְּיוֹתֵר, עַל גַּבֵּי אוֹר לָבָן מַתַּכְּתִי, צָפוּף וְאָטוּם בְּדַרְגָּתוֹ הָעֶלְיוֹנָה בְּיוֹתֵר.
כָּךְ נוֹצָר בְּדִיּוּק חָזוֹן לָכִיד לְגַמְרֵי, הַמְּבַטֵּא סִכּוּם מֻחְלָט שֶׁל כָּל הָעוֹלָמוֹת, מִנְּקֻדַּת הַמַּבָּט הַתִּפְעוּלִית הַזֹּאת, לְעֵבֶר הִתְגַּלּוּת נִצְחִית וּמִתְמַשֶּׁכֶת שֶׁל מוּסִיקַת הַסְּפֵרוֹת הַשְּׁמֵימִיּוֹת.
וּשׁוּב, הַהַבְחָנָה הַמַּפְתֵּחַ בַּכִּתַּאבּ אַלְמֻבִּין הִיא בֵּין כָּל הַתּוֹרְמִים לִמְצִיאוּת הַנִּירְוָאנָה הָעֶלְיוֹנָה בְּיוֹתֵר וְהָאַחֲרוֹנָה הַזֹּאת, וּבֵין כָּל מִי שֶׁאֵינוֹ יָכוֹל לִהְיוֹת חֵלֶק מֵאֱמֶת הַסּוֹף הַמֻּחְלָט.
